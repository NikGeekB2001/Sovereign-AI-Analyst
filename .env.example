# ============================================
# Sovereign AI Analyst — переменные окружения
# Скопируйте в .env и заполните свои значения
# ============================================

# --- LLM ---
# backend: ollama | vllm
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Для vLLM:
# LLM_BACKEND=vllm
# VLLM_BASE_URL=http://localhost:8000

# --- Эмбеддинги (Ollama) ---
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=qwen2.5:7b

# --- Базы данных ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ruslawod

# --- Langfuse (трассировка) ---
# Включите и укажите ключи из https://cloud.langfuse.com или локального инстанса
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENABLED=false

# --- Langfuse UI / Docker (docker-compose) ---
NEXTAUTH_SECRET=change-me
SALT=change-me
POSTGRES_PASSWORD=langfuse
GF_SECURITY_ADMIN_PASSWORD=admin
