@startuml
skinparam linetype ortho
skinparam {
    ArrowColor #555
    ArrowThickness 1.5
    ArrowFontColor #333
    EntityBorderColor #2563eb
    EntityFontColor #333
}

title ER Diagram: Data Model for Sovereign-AI-Analyst Platform

' ============================================================
' ПОЛЬЗОВАТЕЛИ И РОЛИ (RBAC)
' ============================================================
entity "User" {
  * user_id : UUID <<PK>>
  --
  * username : String
  * email : String
  * password_hash : String
  * role_id : UUID <<FK>>
  * department : String
  * is_active : Boolean
  * created_at : DateTime
  * last_login : DateTime
}

entity "Role" {
  * role_id : UUID <<PK>>
  --
  * name : String
  * description : String
  * clearance_level : Integer
  * permissions : JSON
  * created_at : DateTime
}

entity "RBAC_Policy" {
  * policy_id : UUID <<PK>>
  --
  * role_id : UUID <<FK>>
  * resource_type : String
  * resource_id : UUID <<FK>>
  * access_level : Integer
  * allowed_actions : String[]
  * created_at : DateTime
}

' ============================================================
' ДОКУМЕНТЫ И ЧАНКИ
' ============================================================
entity "Document" {
  * doc_id : UUID <<PK>>
  --
  * title : String
  * source : String
  * original_filename : String
  * content_hash : String
  * doc_type : String
  * owner_id : UUID <<FK>>
  * access_level : Integer
  * allowed_roles : String[]
  * ingestion_status : String
  * created_at : DateTime
  * processed_at : DateTime
}

entity "Chunk" {
  * chunk_id : UUID <<PK>>
  --
  * doc_id : UUID <<FK>>
  * text : String
  * embedding : Vector
  * chunk_index : Integer
  * access_level : Integer
  * allowed_roles : String[]
  * metadata : JSON
  * created_at : DateTime
}

' ============================================================
' ГРАФ ЗНАНИЙ (Knowledge Graph)
' ============================================================
entity "Graph_Node (Entity)" {
  * entity_id : UUID <<PK>>
  --
  * name : String
  * type : String
  * description : String
  * access_level : Integer
  * allowed_roles : String[]
  * properties : JSON
  * confidence_score : Float
  * created_at : DateTime
}

entity "Graph_Edge (Relationship)" {
  * rel_id : UUID <<PK>>
  --
  * source_entity_id : UUID <<FK>>
  * target_entity_id : UUID <<FK>>
  * type : String
  * access_level : Integer
  * allowed_roles : String[]
  * properties : JSON
  * created_at : DateTime
}

entity "Document_Entity_Link" {
  * link_id : UUID <<PK>>
  --
  * doc_id : UUID <<FK>>
  * entity_id : UUID <<FK>>
  * chunk_id : UUID <<FK>>
  * extraction_method : String
  * confidence_score : Float
  * created_at : DateTime
}

' ============================================================
' СЕССИИ И СОСТОЯНИЕ АГЕНТОВ
' ============================================================
entity "Session" {
  * session_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * started_at : DateTime
  * last_activity : DateTime
  * session_state : JSON
  * is_active : Boolean
}

entity "Agent_State" {
  * state_id : UUID <<PK>>
  --
  * session_id : UUID <<FK>>
  * agent_type : String
  * plan : JSON
  * current_step : Integer
  * state_data : JSON
  * execution_metadata : JSON
  * timestamp : DateTime
  * last_updated : DateTime
}

entity "Agent_History" {
  * history_id : UUID <<PK>>
  --
  * session_id : UUID <<FK>>
  * agent_type : String
  * action : String
  * details : JSON
  * timestamp : DateTime
}

' ============================================================
' ЗАПРОСЫ И ОТВЕТЫ
' ============================================================
entity "Query" {
  * query_id : UUID <<PK>>
  --
  * session_id : UUID <<FK>>
  * user_id : UUID <<FK>>
  * query_text : String
  * user_role : String
  * clearance_level : Integer
  * timestamp : DateTime
}

entity "Response" {
  * response_id : UUID <<PK>>
  --
  * query_id : UUID <<FK>>
  * response_text : Text
  * is_final : Boolean
  * filtered_context_count : Integer
  * total_tokens_used : Integer
  * processing_time_ms : Float
  * timestamp : DateTime
}

' ============================================================
' GUARDRAILS И АУДИТ
' ============================================================
entity "Guardrail_Check" {
  * check_id : UUID <<PK>>
  --
  * query_id : UUID <<FK>>
  * response_id : UUID <<FK>>
  * check_type : String
  * is_safe : Boolean
  * issues : JSON
  * severity : String
  * timestamp : DateTime
}

entity "Audit_Log" {
  * log_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * session_id : UUID <<FK>>
  * action : String
  * resource_type : String
  * resource_id : UUID
  * access_granted : Boolean
  * denial_reason : String
  * timestamp : DateTime
  * details : JSON
}

' ============================================================
' OBSERVABILITY (Langfuse)
' ============================================================
entity "Langfuse_Trace" {
  * trace_id : UUID <<PK>>
  --
  * session_id : UUID <<FK>>
  * query_id : UUID <<FK>>
  * name : String
  * user_id : UUID <<FK>>
  * input_tokens : Integer
  * output_tokens : Integer
  * total_cost : Float
  * latency_ms : Float
  * model_name : String
  * status : String
  * timestamp : DateTime
  * metadata : JSON
}

entity "Langfuse_Span" {
  * span_id : UUID <<PK>>
  --
  * trace_id : UUID <<FK>>
  * parent_span_id : UUID <<FK>>
  * agent_type : String
  * operation : String
  * input_data : JSON
  * output_data : JSON
  * start_time : DateTime
  * end_time : DateTime
  * status : String
}

' ============================================================
' LLM REGISTRY (Circular Fallback)
' ============================================================
entity "LLM_Model" {
  * model_id : UUID <<PK>>
  --
  * name : String
  * provider : String
  * api_base_url : String
  * is_active : Boolean
  * priority : Integer
  * max_retries : Integer
  * timeout_seconds : Integer
  * created_at : DateTime
}

entity "LLM_Fallback_Log" {
  * log_id : UUID <<PK>>
  --
  * session_id : UUID <<FK>>
  * from_model_id : UUID <<FK>>
  * to_model_id : UUID <<FK>>
  * error_type : String
  * error_message : String
  * fallback_at : DateTime
}

' ============================================================
' RATE LIMITING
' ============================================================
entity "Rate_Limit_Config" {
  * config_id : UUID <<PK>>
  --
  * endpoint : String
  * limit_per_minute : Integer
  * limit_per_hour : Integer
  * limit_per_day : Integer
  * is_active : Boolean
  * created_at : DateTime
}

entity "Rate_Limit_Violation" {
  * violation_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * endpoint : String
  * violation_type : String
  * ip_address : String
  * timestamp : DateTime
}

' ============================================================
' LONG-TERM MEMORY (mem0)
' ============================================================
entity "Long_Term_Memory" {
  * memory_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * memory_text : Text
  * embedding : Vector
  * source_session_id : UUID <<FK>>
  * created_at : DateTime
  * updated_at : DateTime
}

' ============================================================
' CACHE (Valkey/Redis)
' ============================================================
entity "Cache_Entry" {
  * cache_key : String <<PK>>
  --
  * value : Text
  * ttl_seconds : Integer
  * created_at : DateTime
}

' ============================================================
' RUSLAWOD: РОССИЙСКИЕ ПРАВОВЫЕ АКТЫ (304K XML)
' ============================================================
entity "Legal_Document" {
  * doc_id : String <<PK>>
  --
  * title : String
  * doc_type : String
  * author_org : String
  * doc_date : Date
  * doc_number : String
  * status : String
  * is_widely_used : Boolean
  * text_content : Text
  * classifier_code : String
  * access_level : Integer
  * allowed_roles : String[]
  * source : String
}

entity "Legal_Entity" {
  * entity_id : UUID <<PK>>
  --
  * name : String
  * type : String
  * description : String
  * access_level : Integer
  * allowed_roles : String[]
}

entity "Legal_Keyword" {
  * keyword_id : UUID <<PK>>
  --
  * name : String
  * classifier_code : String
}

entity "Legal_Reference" {
  * ref_id : UUID <<PK>>
  --
  * source_doc_id : String <<FK>>
  * target_doc_id : String <<FK>>
  * ref_type : String
}

' ============================================================
' RFSD: ФИНАНСОВАЯ ОТЧЕТНОСТЬ
' ============================================================
entity "Financial_Report" {
  * report_id : UUID <<PK>>
  --
  * company_name : String
  * inn : String
  * report_type : String
  * period : String
  * revenue : Float
  * net_income : Float
  * total_assets : Float
  * access_level : Integer
  * allowed_roles : String[]
}

' ============================================================
' СВЯЗИ
' ============================================================

' Пользователи и роли
User }o--|| Role : "имеет"
Role ||--o{ RBAC_Policy : "определяет"
User ||--o{ Document : "владеет"

' Документы и чанки
Document ||--o{ Chunk : "разбивается на"

' Knowledge Graph
Graph_Node ||--o{ Graph_Edge : "источник"
Graph_Node }o--o{ Graph_Edge : "цель"
Document ||--o{ Document_Entity_Link : "порождает сущности"
Graph_Node ||--o{ Document_Entity_Link : "извлечен из"
Chunk ||--o{ Document_Entity_Link : "содержит"

' Сессии
User ||--o{ Session : "создает"
Session ||--o{ Agent_State : "содержит"
Session ||--o{ Agent_History : "записывает"
Session ||--o{ Query : "содержит"

' Запросы и ответы
Query ||--o| Response : "имеет"
Query ||--o{ Guardrail_Check : "проверяется"
Response ||--o{ Guardrail_Check : "проверяется"

' Аудит
Session ||--o{ Audit_Log : "логирует"
User ||--o{ Audit_Log : "действует"

' Observability
Query ||--o{ Langfuse_Trace : "трассируется"
Langfuse_Trace ||--o{ Langfuse_Span : "содержит спаны"
Langfuse_Span ||--o{ Langfuse_Span : "parent-child"

' RBAC связи
RBAC_Policy }o--|| Document : "регулирует доступ"
RBAC_Policy }o--|| Graph_Node : "регулирует доступ"

' LLM Registry связи
LLM_Fallback_Log }o--|| LLM_Model : "from_model"
LLM_Fallback_Log }o--|| LLM_Model : "to_model"
LLM_Fallback_Log }o--|| Session : "сессия"

' Rate Limiting связи
Rate_Limit_Violation }o--|| User : "нарушитель"

' Long-term Memory связи
Long_Term_Memory }o--|| User : "принадлежит"
Long_Term_Memory }o--|| Session : "из сессии"

' RusLawOD связи
Legal_Document ||--o{ Legal_Reference : "ссылается на"
Legal_Document }o--|| Legal_Entity : "издан органом"
Legal_Document ||--o{ Legal_Keyword : "тематика"
Legal_Reference }o--|| Legal_Document : "source"
Legal_Reference }o--|| Legal_Document : "target"
Legal_Document ||--o{ Chunk : "разбивается на"

' RFSD связи
Financial_Report }o--|| User : "доступно для"

@enduml